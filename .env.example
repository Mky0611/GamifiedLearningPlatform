# ==============================================================================
# GamifiedLearningPlatform - Environment Variables Template
# ==============================================================================
# Huong dan su dung:
# 1. Sao chep file nay thanh .env de cau hinh bien moi truong tren may dev cua ban.
# 2. File .env da duoc them vao .gitignore, KHONG commit .env len repository.
# 3. Khi chay Spring Boot tren IDE hoac Docker, truyen cac bien moi truong nay.
# ==============================================================================

# Port cho ung dung Spring Boot
SERVER_PORT=8080

# Ket noi toi SQL Server
# Mac dinh ket noi local port 1433, database GamifiedLearningPlatform
SPRING_DATASOURCE_URL=jdbc:sqlserver://localhost:1433;databaseName=GamifiedLearningPlatform;encrypt=false;trustServerCertificate=true
SPRING_DATASOURCE_USERNAME=sa
# DIEN MAT KHAU SQL SERVER CUA BAN VAO DAY (Chi luu tren may local, khong commit):
SPRING_DATASOURCE_PASSWORD=your_secure_db_password_here

# Danh sach Allowed Origins cho CORS (ngan cach boi dau phay)
APP_CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
