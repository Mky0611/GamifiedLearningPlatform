{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/app", "destination": "/", "permanent": true },
    { "source": "/app/", "destination": "/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/", "destination": "/src/main/resources/FrontEnd/src/pages/home.html" },
    { "source": "/robots.txt", "destination": "/src/main/resources/FrontEnd/robots.txt" },
    { "source": "/sitemap.xml", "destination": "/src/main/resources/FrontEnd/sitemap.xml" },
    { "source": "/404.html", "destination": "/src/main/resources/FrontEnd/404.html" },
    { "source": "/app/home", "destination": "/src/main/resources/FrontEnd/src/pages/home.html" },
    { "source": "/app/auth", "destination": "/src/main/resources/FrontEnd/src/pages/auth.html" },
    { "source": "/app/minigame", "destination": "/src/main/resources/FrontEnd/src/pages/minigame.html" },
    { "source": "/app/quiz", "destination": "/src/main/resources/FrontEnd/src/pages/quiz.html" },
    { "source": "/app/volcard", "destination": "/src/main/resources/FrontEnd/src/pages/volcard.html" },
    { "source": "/app/memory", "destination": "/src/main/resources/FrontEnd/src/pages/memory.html" },
    { "source": "/app/speed-math", "destination": "/src/main/resources/FrontEnd/src/pages/speed-math.html" },
    { "source": "/app/code-puzzle", "destination": "/src/main/resources/FrontEnd/src/pages/code-puzzle.html" },
    { "source": "/app/account", "destination": "/src/main/resources/FrontEnd/src/pages/account.html" },
    { "source": "/app/typography", "destination": "/src/main/resources/FrontEnd/src/pages/typography-specimen.html" },
    { "source": "/ui/assets/(.*)", "destination": "/src/main/resources/FrontEnd/assets/$1" },
    { "source": "/ui/src/(.*)", "destination": "/src/main/resources/FrontEnd/src/$1" },
    { "source": "/ui/(.*)", "destination": "/src/main/resources/FrontEnd/$1" },
    { "source": "/assets/(.*)", "destination": "/src/main/resources/FrontEnd/assets/$1" },
    { "source": "/src/(.*)", "destination": "/src/main/resources/FrontEnd/src/$1" }
  ]
}
